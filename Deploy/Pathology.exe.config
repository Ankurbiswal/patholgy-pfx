<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- 
      To connect to a DIFFERENT SERVER on your network:
      Change ".\sqlexpress" to the server IP or hostname, e.g. "192.168.1.10\SQLEXPRESS"
      
      Example for network server:
      connectionString="Data Source=192.168.1.10\SQLEXPRESS;Initial Catalog=pathology2627;Persist Security Info=True;User ID=sa;Password=software;"
    -->
    <add name="PathologyDB"
         connectionString="Data Source=.\sqlexpress;Initial Catalog=pathology2627;Persist Security Info=True;User ID=sa;Password=software;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="EnvDTE" publicKeyToken="B03F5F7F11D50A3A" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
